<div class="wraeclast-generator-body">
  {{#if error}}
  <div class="wraeclast-error" role="alert">
    <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> {{error}}
  </div>
  {{/if}}

  {{#if ready}}
  <section class="wraeclast-controls" aria-label="Generator controls">
    <div class="wraeclast-toolbar">
      <label class="wide-field">
        <span>Campaign preset</span>
        <select name="preset">
          {{#each presets}}
          <option value="{{value}}" {{#if selected}}selected{{/if}} title="{{description}}">{{label}}</option>
          {{/each}}
        </select>
      </label>
      <label class="wide-field">
        <span>Chat visibility</span>
        <select name="chatMode">
          {{#each chatModes}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
      <label class="wide-field">
        <span>Output detail</span>
        <select name="outputMode">
          {{#each outputModes}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
      <label class="wide-field">
        <span>Name generation</span>
        <select name="nameMode">
          {{#each nameModes}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
      <label class="wide-field">
        <span>Given-name fragments</span>
        <select name="nameFragmentCount" {{#if fragmentCountDisabled}}disabled{{/if}}>
          {{#each nameFragmentCounts}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
    </div>

    {{#if presetDescription}}<p class="preset-description">{{presetDescription}}</p>{{/if}}

    <p class="name-generation-hint">Fragment mode builds the given name from culture-specific positional groups; existing surname frequency and form remain unchanged. Ordained Templars always use bestowed virtue-names. These controls apply on the next generation or name reroll.</p>

    <p class="hint"><i class="fa-solid fa-lock" aria-hidden="true"></i> Choosing a value locks it. Locking a random field captures the first preview; unlocking returns it to weighted random.</p>
    {{#if hasPinnedSections}}<p class="pin-hint"><i class="fa-solid fa-thumbtack" aria-hidden="true"></i> {{pinnedSectionCount}} section(s) pinned. Regeneration keeps this NPC's identity and replaces only unpinned sections.</p>{{/if}}

    <div class="wraeclast-filter-grid">
      <label>
        <span>Culture</span>
        <span class="filter-row">
          <select name="culture" data-filter="culture">
            {{#each cultures}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
          <button type="button" class="lock-button {{#if locks.culture}}active{{/if}}" data-action="toggleLock" data-field="culture" title="Toggle culture lock" aria-label="Toggle culture lock"><i class="fa-solid {{#if locks.culture}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button>
        </span>
      </label>

      <label>
        <span>Faction / affiliation</span>
        <span class="filter-row">
          <select name="affiliation" data-filter="affiliation">
            {{#each affiliations}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
          <button type="button" class="lock-button {{#if locks.affiliation}}active{{/if}}" data-action="toggleLock" data-field="affiliation" title="Toggle affiliation lock" aria-label="Toggle affiliation lock"><i class="fa-solid {{#if locks.affiliation}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button>
        </span>
      </label>

      {{#if hasBranches}}
      <label>
        <span>{{branchLabel}}</span>
        <span class="filter-row">
          <select name="branch" data-filter="branch">
            {{#each branches}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
          <button type="button" class="lock-button {{#if locks.branch}}active{{/if}}" data-action="toggleLock" data-field="branch" title="Toggle clan or subfaction lock" aria-label="Toggle clan or subfaction lock"><i class="fa-solid {{#if locks.branch}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button>
        </span>
      </label>
      {{/if}}

      <label>
        <span>Species</span>
        <span class="filter-row">
          <select name="species" data-filter="species">
            {{#each species}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
          <button type="button" class="lock-button {{#if locks.species}}active{{/if}}" data-action="toggleLock" data-field="species" title="Toggle species lock" aria-label="Toggle species lock"><i class="fa-solid {{#if locks.species}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button>
        </span>
      </label>

      <label>
        <span>Social origin</span>
        <span class="filter-row">
          <select name="socialOrigin" data-filter="socialOrigin">
            {{#each socialOrigins}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
          <button type="button" class="lock-button {{#if locks.socialOrigin}}active{{/if}}" data-action="toggleLock" data-field="socialOrigin" title="Toggle origin lock" aria-label="Toggle origin lock"><i class="fa-solid {{#if locks.socialOrigin}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button>
        </span>
      </label>

      <label>
        <span>Age</span>
        <span class="filter-row">
          <select name="age" data-filter="age">
            {{#each ages}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
          <button type="button" class="lock-button {{#if locks.age}}active{{/if}}" data-action="toggleLock" data-field="age" title="Toggle age lock" aria-label="Toggle age lock"><i class="fa-solid {{#if locks.age}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button>
        </span>
      </label>

      <label>
        <span>Alignment</span>
        <span class="filter-row">
          <select name="alignment" data-filter="alignment">
            {{#each alignments}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
          <button type="button" class="lock-button {{#if locks.alignment}}active{{/if}}" data-action="toggleLock" data-field="alignment" title="Toggle alignment lock" aria-label="Toggle alignment lock"><i class="fa-solid {{#if locks.alignment}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button>
        </span>
      </label>

      <label>
        <span>Profession category</span>
        <span class="filter-row">
          <select name="professionCategory" data-filter="professionCategory">
            {{#each professionCategories}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
          <button type="button" class="lock-button {{#if locks.professionCategory}}active{{/if}}" data-action="toggleLock" data-field="professionCategory" title="Toggle profession lock" aria-label="Toggle profession lock"><i class="fa-solid {{#if locks.professionCategory}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button>
        </span>
      </label>

      <label>
        <span>Location</span>
        <span class="filter-row">
          <select name="location" data-filter="location">
            {{#each locations}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
          <button type="button" class="lock-button {{#if locks.location}}active{{/if}}" data-action="toggleLock" data-field="location" title="Toggle location lock" aria-label="Toggle location lock"><i class="fa-solid {{#if locks.location}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button>
        </span>
      </label>

      <label>
        <span>Era</span>
        <span class="filter-row">
          <select name="era" data-filter="era">
            {{#each eras}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
          <button type="button" class="lock-button {{#if locks.era}}active{{/if}}" data-action="toggleLock" data-field="era" title="Toggle era lock" aria-label="Toggle era lock"><i class="fa-solid {{#if locks.era}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button>
        </span>
      </label>

      <label>
        <span>Capability</span>
        <span class="filter-row">
          <select name="capabilityTier" data-filter="capabilityTier">
            {{#each capabilityTiers}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
          <button type="button" class="lock-button {{#if locks.capabilityTier}}active{{/if}}" data-action="toggleLock" data-field="capabilityTier" title="Toggle capability lock" aria-label="Toggle capability lock"><i class="fa-solid {{#if locks.capabilityTier}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button>
        </span>
      </label>
    </div>

    <div class="generate-row">
      <button type="button" class="generate-button" data-action="generate">
        <i class="fa-solid fa-dice" aria-hidden="true"></i> {{generateLabel}}
      </button>
      <button type="button" class="clear-recent-button" data-action="clearRecent" title="Allow recently generated names and details again" {{#unless recentResultCount}}disabled{{/unless}}>
        <i class="fa-solid fa-eraser" aria-hidden="true"></i> Clear recent{{#if recentResultCount}} ({{recentResultCount}}){{/if}}
      </button>
    </div>
  </section>

  <section class="wraeclast-results" aria-live="polite">
    {{#each results}}
    <article class="npc-preview">
      <header>
        <div>
          {{#if editing}}
          <label class="inline-edit name-edit"><span>Name</span><input type="text" value="{{fullName}}" data-edit-field="fullName"></label>
          {{else}}<h2>{{fullName}}</h2>{{/if}}
          <p class="name-style">{{nameStyle}}{{#if hasNameFragments}} · {{nameFragmentDisplay}}{{/if}}</p>
          <p class="identity-line"><strong>{{culture}}</strong>{{#if showAffiliation}} · {{affiliation}}{{/if}}{{#if showBranch}} · {{branchDisplay}}{{/if}} · {{species}} · {{age}} · {{alignment}}</p>
          <p class="origin-line">{{socialOrigin}} · {{location}} · {{era}} · {{capabilityTier}}</p>
        </div>
        <div class="preview-history">
          <button type="button" class="icon-button" data-action="undo" title="Undo last change" aria-label="Undo last change" {{#unless ../canUndo}}disabled{{/unless}}><i class="fa-solid fa-rotate-left"></i></button>
          <button type="button" class="icon-button" data-action="redo" title="Redo change" aria-label="Redo change" {{#unless ../canRedo}}disabled{{/unless}}><i class="fa-solid fa-rotate-right"></i></button>
          <button type="button" class="edit-button" data-action="toggleEdit"><i class="fa-solid fa-pen"></i> {{#if editing}}Done{{else}}Edit{{/if}}</button>
          <button type="button" class="icon-button pin-button {{#if pinName}}active{{/if}}" data-action="toggleSectionPin" data-section="name" title="{{#if pinName}}Unpin{{else}}Pin{{/if}} name for regeneration" aria-label="{{#if pinName}}Unpin{{else}}Pin{{/if}} name"><i class="fa-solid fa-thumbtack"></i></button>
          <button type="button" class="icon-button" data-action="reroll" data-index="{{index}}" data-section="name" title="Reroll name" aria-label="Reroll name"><i class="fa-solid fa-dice"></i></button>
        </div>
      </header>

      <div class="preview-grid">
        <section>
          <h3><span>Profession</span><span class="section-actions"><button type="button" class="icon-button pin-button {{#if pinProfession}}active{{/if}}" data-action="toggleSectionPin" data-section="profession" title="{{#if pinProfession}}Unpin{{else}}Pin{{/if}} profession" aria-label="{{#if pinProfession}}Unpin{{else}}Pin{{/if}} profession"><i class="fa-solid fa-thumbtack"></i></button><button type="button" class="icon-button" data-action="reroll" data-index="{{index}}" data-section="profession" title="Reroll profession" aria-label="Reroll profession"><i class="fa-solid fa-rotate"></i></button></span></h3>
          {{#if editing}}
          <label class="inline-edit"><span>Profession</span><input type="text" value="{{profession}}" data-edit-field="profession"></label>
          <label class="inline-edit"><span>Organisation</span><input type="text" value="{{organization}}" data-edit-field="organization"></label>
          <label class="inline-edit"><span>Rank</span><input type="text" value="{{rank}}" data-edit-field="rank"></label>
          {{else}}
          <p>{{profession}} <em>({{professionCategory}})</em></p>
          {{#if organization}}<p class="detail-line">{{organization}}</p>{{/if}}
          {{#if rank}}<p class="detail-line">{{rank}}{{#if showOrdination}} · {{ordination}}{{/if}}</p>{{/if}}
          {{/if}}
        </section>

        <section>
          <h3><span>Appearance</span><span class="section-actions"><button type="button" class="icon-button pin-button {{#if pinAppearance}}active{{/if}}" data-action="toggleSectionPin" data-section="appearance" title="{{#if pinAppearance}}Unpin{{else}}Pin{{/if}} appearance" aria-label="{{#if pinAppearance}}Unpin{{else}}Pin{{/if}} appearance"><i class="fa-solid fa-thumbtack"></i></button><button type="button" class="icon-button" data-action="reroll" data-index="{{index}}" data-section="appearance" title="Reroll appearance" aria-label="Reroll appearance"><i class="fa-solid fa-rotate"></i></button></span></h3>
          {{#if editing}}
          <label class="inline-edit"><span>Build</span><input type="text" value="{{build}}" data-edit-field="build"></label>
          <label class="inline-edit"><span>Features</span><input type="text" value="{{features}}" data-edit-field="features"></label>
          <label class="inline-edit"><span>Attire</span><input type="text" value="{{attire}}" data-edit-field="attire"></label>
          <label class="inline-edit"><span>Mark</span><input type="text" value="{{distinguishingMark}}" data-edit-field="distinguishingMark"></label>
          <label class="inline-edit"><span>Voice</span><input type="text" value="{{voice}}" data-edit-field="voice"></label>
          {{else}}
          <p><strong>Build:</strong> {{build}}<br><strong>Features:</strong> {{features}}<br><strong>Attire:</strong> {{attire}}<br><strong>Mark:</strong> {{distinguishingMark}}</p>
          <p class="detail-line">{{voice}}</p>
          {{/if}}
        </section>

        <section>
          <h3><span>Personality</span><span class="section-actions"><button type="button" class="icon-button pin-button {{#if pinPersonality}}active{{/if}}" data-action="toggleSectionPin" data-section="personality" title="{{#if pinPersonality}}Unpin{{else}}Pin{{/if}} personality" aria-label="{{#if pinPersonality}}Unpin{{else}}Pin{{/if}} personality"><i class="fa-solid fa-thumbtack"></i></button><button type="button" class="icon-button" data-action="reroll" data-index="{{index}}" data-section="personality" title="Reroll personality" aria-label="Reroll personality"><i class="fa-solid fa-rotate"></i></button></span></h3>
          {{#if editing}}
          <label class="inline-edit"><span>Demeanor</span><input type="text" value="{{demeanorText}}" data-edit-field="demeanor"></label>
          <label class="inline-edit"><span>Attitude</span><input type="text" value="{{attitudeText}}" data-edit-field="attitude"></label>
          <label class="inline-edit"><span>Mannerism</span><input type="text" value="{{mannerism}}" data-edit-field="mannerism"></label>
          {{else}}
          <p><strong>Demeanor:</strong> {{#each demeanor}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>
          <p><strong>Attitude:</strong> {{#each attitude}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>
          <p class="detail-line">{{mannerism}}</p>
          {{/if}}
        </section>

        <section>
          <h3><span>Hooks</span><span class="section-actions"><button type="button" class="icon-button pin-button {{#if pinHooks}}active{{/if}}" data-action="toggleSectionPin" data-section="hooks" title="{{#if pinHooks}}Unpin{{else}}Pin{{/if}} hooks" aria-label="{{#if pinHooks}}Unpin{{else}}Pin{{/if}} hooks"><i class="fa-solid fa-thumbtack"></i></button><button type="button" class="icon-button" data-action="reroll" data-index="{{index}}" data-section="hooks" title="Reroll hooks" aria-label="Reroll hooks"><i class="fa-solid fa-rotate"></i></button></span></h3>
          {{#if editing}}
          <label class="inline-edit"><span>Ideal</span><textarea rows="2" data-edit-field="ideal">{{ideal}}</textarea></label>
          <label class="inline-edit"><span>Bond</span><textarea rows="2" data-edit-field="bond">{{bond}}</textarea></label>
          <label class="inline-edit"><span>Flaw</span><textarea rows="2" data-edit-field="flaw">{{flaw}}</textarea></label>
          {{else}}
          <p><strong>Ideal:</strong> {{ideal}}</p>
          <p><strong>Bond:</strong> {{bond}}</p>
          <p><strong>Flaw:</strong> {{flaw}}</p>
          {{/if}}
        </section>

        <section class="span-two narrative-section">
          <h3><span>Immediate use</span><span class="section-actions"><button type="button" class="icon-button pin-button {{#if pinDrives}}active{{/if}}" data-action="toggleSectionPin" data-section="drives" title="{{#if pinDrives}}Unpin{{else}}Pin{{/if}} immediate-use details" aria-label="{{#if pinDrives}}Unpin{{else}}Pin{{/if}} immediate-use details"><i class="fa-solid fa-thumbtack"></i></button><button type="button" class="icon-button" data-action="reroll" data-index="{{index}}" data-section="drives" title="Reroll immediate-use details" aria-label="Reroll immediate-use details"><i class="fa-solid fa-rotate"></i></button></span></h3>
          {{#if editing}}
          <div class="narrative-edit-grid">
            <label class="inline-edit"><span>Goal</span><textarea rows="2" data-edit-field="goal">{{goal}}</textarea></label>
            <label class="inline-edit"><span>Problem</span><textarea rows="2" data-edit-field="problem">{{problem}}</textarea></label>
            <label class="inline-edit"><span>Secret</span><textarea rows="2" data-edit-field="secret">{{secret}}</textarea></label>
            <label class="inline-edit"><span>Knowledge</span><textarea rows="2" data-edit-field="knowledge">{{knowledge}}</textarea></label>
            <label class="inline-edit"><span>Offer</span><textarea rows="2" data-edit-field="offer">{{offer}}</textarea></label>
            <label class="inline-edit"><span>Disposition</span><textarea rows="2" data-edit-field="disposition">{{disposition}}</textarea></label>
          </div>
          {{else}}
          <div class="narrative-grid">
            <p><strong>Goal:</strong> {{goal}}</p>
            <p><strong>Problem:</strong> {{problem}}</p>
            <p><strong>Secret:</strong> {{secret}}</p>
            <p><strong>Knowledge:</strong> {{knowledge}}</p>
            <p><strong>Offer:</strong> {{offer}}</p>
            <p><strong>Disposition:</strong> {{disposition}}</p>
          </div>
          {{/if}}
        </section>
      </div>

      <footer class="npc-actions">
        <button type="button" data-action="sendChat" data-index="{{index}}"><i class="fa-solid fa-comment"></i> Chat</button>
        <button type="button" data-action="saveJournal" data-index="{{index}}"><i class="fa-solid fa-book-open"></i> Journal</button>
        {{#if ../canCreateActor}}<button type="button" data-action="createActor" data-index="{{index}}"><i class="fa-solid fa-user-plus"></i> Actor</button>{{/if}}
        {{#if ../canForgeActor}}<button type="button" data-action="createAndForge" data-index="{{index}}"><i class="fa-solid fa-hammer"></i> Actor + Forge</button>{{/if}}
        <button type="button" data-action="copyNpc" data-index="{{index}}"><i class="fa-solid fa-copy"></i> Copy</button>
      </footer>
    </article>
    {{else}}
    <div class="empty-preview">
      <i class="fa-solid fa-skull" aria-hidden="true"></i>
      <p>Choose a preset or any locks, then generate a preview. Nothing is posted or saved until you choose an output action.</p>
    </div>
    {{/each}}
  </section>
  {{/if}}
</div>
